# ===========================================================
# 统一环境变量配置
# 复制为 .env 并填入真实值：cp .env.example .env
# Docker 部署：只改这个文件即可
# 本地开发：复制 backend/.env.example 到 backend/.env
# ===========================================================

# ==================== Docker Compose 服务端口 ====================
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
FRONTEND_PORT=80

# ==================== PostgreSQL ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=industry_assistant

# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-max

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== JWT 认证 ====================
# 生产环境务必修改为随机密钥
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== Eval Framework（可选） ====================
DEEPSEEK_API_KEY=your-deepseek-api-key
XIAOMI_API_KEY=your-xiaomi-mimo-api-key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=industry-research-eval

# ==================== 其他配置 ====================
TIMEZONE=Asia/Shanghai
