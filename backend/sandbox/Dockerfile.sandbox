# syntax=docker/dockerfile:1.7
# 沙箱镜像：仅含绘图依赖 + runner.py，不含任何项目业务代码。
FROM python:3.11-slim

# 中文字体（matplotlib 渲染中文）
RUN apt-get update && apt-get install -y --no-install-recommends \
        fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

# 版本号用引号包裹，避免 shell 把 ">=" 当成重定向操作符
RUN pip install --no-cache-dir \
        "pandas>=2.0.0" "numpy>=1.24.0" "matplotlib>=3.7.0" \
        "seaborn>=0.12.0" "wordcloud>=1.9.0" "jieba>=0.42.0"

# matplotlib/字体缓存目录（容器 read-only 时由 tmpfs 提供 /tmp）
ENV MPLCONFIGDIR=/tmp \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY runner.py /runner.py

# 默认入口：执行 runner（代码经环境变量 SANDBOX_CODE 注入）
CMD ["python", "/runner.py"]
