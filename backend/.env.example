# ===== App =====
APP_NAME=industry-research-assistant
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Database (PostgreSQL via asyncpg) =====
# 默认指向 docker/docker-compose.yml 起的 ira-postgres
# 凭据见 docker/.env.example
DATABASE_URL=postgresql+asyncpg://deepresearch:deepresearch@localhost:5432/deepresearch
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis =====
# 默认指向 ira-redis；密码与 docker/.env 的 REDIS_PASSWORD 对齐
REDIS_URL=redis://:deepresearch@localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ===== Milvus =====
# 默认指向 ira-milvus；本地 standalone 无鉴权，token 留空即可
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
MILVUS_DB=default

# ===== MinIO =====
# endpoint 是 host:port（不带 http/https 前缀）；secure 控制是否走 HTTPS
# 凭据与 docker/.env 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 对齐
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_REGION=us-east-1

# ===== Auth (JWT) =====
# 生产环境务必替换为高熵随机串：openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_BYTES_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=10080
# bcrypt 工作因子，默认 12；本机测试可调 4 加速
BCRYPT_ROUNDS=12
